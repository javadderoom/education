{
  "name": "edtech-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push && npm run prisma:seed && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node -e \"require('jiti')()('./prisma/seed.ts');\"",
    "validate:cartridges": "node -e \"require('jiti')()('../scripts/validate-cartridges.ts').runCli();\"",
    "test:bkt": "node -e \"require('jiti')()('./scripts/test-bkt.ts');\"",
    "type-check": "tsc --noEmit",
    "test:ui": "vitest run",
    "test": "npm run test:bkt && npm run type-check && vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "agentation": "^3.1.2",
    "clsx": "^2.1.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.1",
    "undici": "^7.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
