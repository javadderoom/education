NODE_ENV=development
DATABASE_URL="postgresql://user:password@host:5432/education?schema=public"

#------ Gemini AI Provider ---------
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

#------ Local Network Proxy (Development Only - Port 10808) ---------
# In local development and Python ingestion, route through local proxy on port 10808.
# On Vercel serverless (production), requests connect directly to Google API without proxy.
HTTP_PROXY="http://127.0.0.1:10808"
HTTPS_PROXY="http://127.0.0.1:10808"
